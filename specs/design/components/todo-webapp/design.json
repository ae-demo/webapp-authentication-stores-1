{
  "name": "todo-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "todo-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5
  ],
  "description": "The single-page app a user signs into and manages their private todo list from: add a todo, view the list, mark items done/not-done, delete items. Talks only to todo-api for data; holds no data itself and never sees another user's todos.",
  "dependencies": [
    {
      "kind": "component",
      "name": "todo-api",
      "wiring": {
        "endpoint": {
          "component": "webapp-authentication-stores-1-todo-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "TODO_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "webapp-authentica-a67b2a1f",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}

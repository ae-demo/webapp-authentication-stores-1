{
  "name": "todo-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "todo-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    2,
    3,
    4,
    5
  ],
  "description": "Owns the todo-item resource: create, list, update (done/not-done) and delete a todo item, always scoped to the signed-in caller's own userId. Persists items in its own Postgres database. Does not manage user accounts or identity — that is Thunder's job — and exposes no admin or cross-user views.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "todo-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "webapp-authentica-cef3c402",
        "envBindings": {
          "dbname": "TODO_DB_DBNAME",
          "host": "TODO_DB_HOST",
          "password": "TODO_DB_PASSWORD",
          "port": "TODO_DB_PORT",
          "user": "TODO_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "webapp-authentica-a67b2a1f",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
